# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (defaults to google/gemma-2-9b-it)
OPENROUTER_MODEL=google/gemma-2-9b-it

# LLM Temperature (0.2 is moderate-low for document grounding)
LLM_TEMPERATURE=0.2

# Site info for OpenRouter HTTP headers (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Abhij-AI

# Admin Panel Access Passcode (defaults to admin123)
ADMIN_PASSWORD=admin123

# Neon Serverless PostgreSQL Database URL (Optional: enables cross-device accounts & cloud chat history sync)
# Create a free project at https://neon.tech and paste your connection string below
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
